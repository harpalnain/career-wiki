# --- Personal data: never commit ---
# Track the empty raw/ folder (placeholder) but ignore any source documents dropped in.
raw/*
!raw/.gitkeep
# Note: wiki/, output/, and log.md are tracked so the repo can ship sample
# demo content. Fork users who add real career data should re-add these here.

# Working notes / temporary specs
docs/

# --- Local tool state ---
.obsidian/
.claude/settings.local.json

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS noise ---
.DS_Store
Thumbs.db
desktop.ini

# --- Python (in case scripts get added) ---
__pycache__/
*.py[cod]
.venv/
venv/
.env

# --- Logs ---
*.log
