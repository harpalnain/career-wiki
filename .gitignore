# --- Personal data: never commit ---
# Track the empty raw/ folder (placeholder) but ignore any source documents dropped in.
raw/*
!raw/.gitkeep
# Your live career data is private and ignored. The repo ships read-only
# samples (example-wiki/, example-log.md) so you can see the shape first.
wiki/
log.md

# Working notes / temporary specs
docs/

# --- Local tool state ---
.obsidian/
.claude/settings.local.json

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS noise ---
.DS_Store
Thumbs.db
desktop.ini

# --- Python (in case scripts get added) ---
__pycache__/
*.py[cod]
.venv/
venv/
.env

# --- Logs ---
*.log
